# Hostinger Apache: serve existing files as-is (favicon.ico, icons, images).
# /favicon.ico is a real file, so it is not rewritten.
# Prerendered routes are directories with index.html. DirectorySlash Off stops
# Apache from 301ing /about to /about/. Slash URLs redirect to the no-slash
# form, and that URL is rewritten internally to index.html (no extra slash, so
# it cannot bounce back into the redirect).
# Unknown paths are not rewritten, so Apache returns 404 and serves 404.html.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  DirectorySlash Off

  # www.usmanitoys.com -> https://usmanitoys.com. The next request still hits the slash rules.
  RewriteCond %{HTTP_HOST} ^www\.usmanitoys.com(?::[0-9]+)?$ [NC]
  RewriteRule ^ https://usmanitoys.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # /about/ and /about// -> /about. "/" is not matched: in .htaccess the
  # relative path for the root request is empty.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # No-slash directory URL -> that directory's index.html. [END] stops the
  # per-directory restart; the target does not end in a slash.
  RewriteCond %{REQUEST_URI} !/index\.html$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ %{REQUEST_URI}/index.html [END]

  # /contact has no prerendered directory. Every other missing path falls
  # through to ErrorDocument instead of the app shell.
  RewriteRule ^contact$ /index.html [L]
</IfModule>
