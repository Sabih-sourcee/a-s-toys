# Copy to .env before `npm run build`. These values are baked into the site.

# Digits only, with country code, no plus. Example: 923001234567
VITE_WHATSAPP_NUMBER=

# Apps Script web app URL ending in /exec
VITE_ORDER_ENDPOINT=

# Google Search Console HTML tag content value (the token only)
VITE_GOOGLE_SITE_VERIFICATION=

VITE_SITE_URL=https://usmanitoys.com

# Phone is still required. Leave the address blank. There is no walk-in shop.
VITE_SHOP_PHONE=TODO: phone
VITE_SHOP_EMAIL=salam@astoys.pk
VITE_SHOP_ADDRESS=
VITE_EXCHANGE_POLICY=7-day replacement for transit damage
VITE_DELIVERY_CHARGES=250
VITE_COURIER=TCS/Leopards
# Delivery is free at or above this subtotal.
VITE_FREE_SHIPPING_OVER=3500
