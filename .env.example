# Copy to .env before `npm run build` only if you need to override defaults.
# Defaults in src/config.ts already ship WhatsApp, email, and Formspree ids.

# Digits only, with country code, no plus. WhatsApp orders: 0314 3814591 → 923143814591
# This number does not take voice calls.
VITE_WHATSAPP_NUMBER=923143814591

# Formspree form ids (orders vs wholesale contact)
VITE_ORDER_FORM_ID=mrpejgyd
VITE_CONTACT_FORM_ID=xqpenkga

# Google Search Console HTML tag content value (the token only)
VITE_GOOGLE_SITE_VERIFICATION=

VITE_SITE_URL=https://usmanitoys.com

# Call line. tel: links always use +923317676995.
VITE_SHOP_PHONE=0331 7676995
VITE_SHOP_EMAIL=atarehman@usmanitoys.com
VITE_SHOP_ADDRESS=
VITE_EXCHANGE_POLICY=7-day replacement for transit damage
VITE_DELIVERY_CHARGES=250
VITE_COURIER=TCS/Leopards
VITE_FREE_SHIPPING_OVER=3500
