# Hostinger Apache: serve existing files as-is (favicon.ico, icons, images).
# Prerendered routes are directories with index.html. DirectorySlash Off stops
# Apache from adding a slash. www, plain http, and a trailing slash all 301 to
# https://usmanitoys.com/<path> in one hop. The slash rule's target is already
# the final host, so www + slash is not two redirects. The next request has no
# slash, and the internal rewrite to index.html cannot bounce back.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  DirectorySlash Off

  # /about/ and /about// -> https://usmanitoys.com/about
  # Also folds www and http into that same hop. Real files have no trailing slash,
  # so /images/products/a.webp is not matched here.
  RewriteCond %{REQUEST_URI} ^/(.+?)/+$
  RewriteRule ^ https://usmanitoys.com/%1 [R=301,L,NE]

  # www.usmanitoys.com/about -> https://usmanitoys.com/about
  RewriteCond %{HTTP_HOST} ^www\.usmanitoys\.com(?::[0-9]+)?$ [NC]
  RewriteRule ^(.+)$ https://usmanitoys.com/$1 [R=301,L,NE]

  # http://usmanitoys.com/about -> https://usmanitoys.com/about
  # Skip when a proxy already terminated TLS (avoids a redirect loop).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.+)$ https://usmanitoys.com/$1 [R=301,L,NE]

  # Homepage is the only URL that keeps a slash.
  RewriteCond %{HTTP_HOST} ^www\.usmanitoys\.com(?::[0-9]+)?$ [NC]
  RewriteRule ^$ https://usmanitoys.com/ [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^$ https://usmanitoys.com/ [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # No-slash directory URL -> that directory's index.html. [END] stops the
  # per-directory restart; the target does not end in a slash.
  RewriteCond %{REQUEST_URI} !/index\.html$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ %{REQUEST_URI}/index.html [END]

  # /contact has no prerendered directory. Every other missing path falls
  # through to ErrorDocument instead of the app shell.
  RewriteRule ^contact$ /index.html [L]
</IfModule>
