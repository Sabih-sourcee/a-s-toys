# Hostinger Apache: serve existing files as-is (favicon.ico, icons, images),
# then fall back to the SPA. /favicon.ico is a real file, so it is not rewritten.
# Prerendered routes are directories with index.html. DirectorySlash Off stops
# Apache from 301ing /about to /about/. Slash URLs redirect to the no-slash
# form, and that URL is rewritten internally to index.html (no extra slash, so
# it cannot bounce back into the redirect).
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  DirectorySlash Off

  RewriteRule ^index\.html$ - [L]

  # /about/ and /about// -> /about. "/" is not matched: in .htaccess the
  # relative path for the root request is empty.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # No-slash directory URL -> that directory's index.html. [END] stops the
  # per-directory restart; the target does not end in a slash.
  RewriteCond %{REQUEST_URI} !/index\.html$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ %{REQUEST_URI}/index.html [END]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
