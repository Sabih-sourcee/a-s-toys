# Hostinger Apache: serve existing files as-is (favicon.ico, icons, images),
# then fall back to the SPA. /favicon.ico is a real file, so it is not rewritten.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
