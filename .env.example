# Copy to .env before `npm run build`. These values are baked into the site.

# Digits only, with country code, no plus. Example: 923001234567
VITE_WHATSAPP_NUMBER=

# Apps Script web app URL ending in /exec
VITE_ORDER_ENDPOINT=

# Google Search Console HTML tag content value (the token only)
VITE_GOOGLE_SITE_VERIFICATION=

VITE_SITE_URL=https://usmanitoys.com

# Replace every TODO before going live. Delivery can be a number (250) once known.
VITE_SHOP_PHONE=TODO: shop phone
VITE_SHOP_ADDRESS=TODO: shop address
VITE_EXCHANGE_POLICY=TODO: 7-day exchange policy
VITE_DELIVERY_CHARGES=TODO: delivery charges
VITE_COURIER=TODO: courier
# Optional. Example: 3500 makes delivery free at or above that subtotal.
VITE_FREE_SHIPPING_OVER=
